# /etc/nginx/sites-available/mnist-api
# Certbot rewrites this file when it issues the certificate:
#   sudo certbot --nginx -d mnist-api.example.com

server {
    listen 80;
    server_name mnist-api.example.com;

    # A 28x28 grayscale payload is about 4KB of JSON. Anything larger is not a digit.
    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
